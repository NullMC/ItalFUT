# Server-only secrets for the Supabase Edge Functions (never prefix with VITE_).
# Local: copy to supabase/functions/.env (git-ignored). Production: `supabase secrets set ...`.
# Don't put any keys in code. See https://docs.stripe.com/keys-best-practices.
# Get these from the Stripe Dashboard -> https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get this from the Stripe Dashboard -> https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Public address of the site (used for success_url / cancel_url)
DOMAIN=http://localhost:5173
